  "components": {
    "schemas": {
      "CameraMode": {
        "required": [
          "aeModeCode",
          "aeMode",
          "isCreativeZone",
          "isMovieMode"
        ],
        "type": "object",
        "properties": {
          "aeModeCode": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint32"
          },
          "aeMode": {
            "type": "string"
          },
          "isCreativeZone": {
            "type": "boolean"
          },
          "isMovieMode": {
            "type": [
