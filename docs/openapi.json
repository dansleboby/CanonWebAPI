                "schema": {
                  "$ref": "#/components/schemas/FlashStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Canon"
        ],
        "summary": "Set the \"flash firing\" setting (\"fire\" or \"off\")",
        "description": "The camera must be in P, Tv, Av or M. With Canon:ForceFlashFiring (default), the setting is set back to Fire before the next capture.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            },
            "text/json": {
              "schema": {
                "type": "string"
              }
            },
            "application/*+json": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "503": {
            "description": "Service Unavailable",
