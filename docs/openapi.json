    "/takepicture": {
      "post": {
        "tags": [
          "Canon"
        ],
        "summary": "Take a picture and return the captured file",
        "description": "The timeout adapts to the shutter speed. The file name is returned in the X-File-Name header.",
        "parameters": [
          {
            "name": "useAutoFocus",
            "in": "query",
            "description": "Focus before shooting.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "fileTypes",
            "in": "query",
            "description": "Comma separated file types to return (e.g. \"jpg\", \"cr3\", \"jpg,cr3\", \"*\"). Defaults to the Canon:CaptureFileTypes setting (JPEG only).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
