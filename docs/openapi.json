                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CameraStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/mode": {
      "get": {
        "tags": [
          "Canon"
        ],
        "summary": "Shooting mode of the camera",
        "description": "AE mode set with the mode dial (e.g. 'Manual Exposure', 'Scene Intelligent Auto'), whether exposure settings can be changed remotely (isCreativeZone) and whether the camera is in movie mode.",
