            ],
            "default": null
          },
          "aperture": {
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          "shutterSpeed": {
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          "whiteBalance": {
