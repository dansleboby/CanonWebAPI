    "/flash": {
      "get": {
        "tags": [
          "Canon"
        ],
        "summary": "State of the \"flash firing\" setting",
        "description": "The SDK only reports values set remotely: 'firing' is the value last set by the API (null before the first one). A change made in the camera menu is not visible. With Canon:ForceFlashFiring (default), the setting is set to Fire when the camera connects and before every capture.",
        "responses": {
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
