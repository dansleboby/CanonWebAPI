{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Canon": {
    "CaptureFileTypes": [ "jpg" ],
    "CaptureTimeoutSeconds": 10,
    "AutoFocusHoldMilliseconds": 800,
    "LiveViewSmallImage": false,
    "KeepCameraScreenOn": false,
    "PreventAutoPowerOff": true,
    "ForceFlashFiring": true,
    "FlashTarget": "Unspecified",
    "BusyRetryCount": 3,
    "BusyRetryDelayMilliseconds": 500
  },
  "LiveView": {
    "FrameIntervalMilliseconds": 30,
    "IdleStopDelayMilliseconds": 3000,
    "ErrorRetryDelayMilliseconds": 1000
  },
  "AutoUpdate": {
    "Enabled": true,
    "Url": "https://dansleboby.github.io/CanonWebAPI/autoupdate.xml"
  }
}
